{
  "sourceLanguage": "en",
  "strings": {
    "action.systemSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기"
          }
        }
      }
    },
    "theme.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the mine pattern you have earned. Color stays within the four mine pigments."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획득한 광산 무늬를 고르세요. 색은 네 가지 광산 안료 안에서 유지됩니다."
          }
        }
      }
    },
    "theme.unlockDepth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks at depth"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해금 심도"
          }
        }
      }
    },
    "theme.selectedNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine appearance saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광산 꾸미기를 저장했습니다."
          }
        }
      }
    },
    "theme.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mine appearance could not be saved. Your prior choice remains."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광산 꾸미기를 저장하지 못했습니다. 이전 선택은 그대로입니다."
          }
        }
      }
    },
    "settings.goal.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 25–360 minutes in five-minute steps. Save only when the promise feels realistic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25–360분 사이에서 5분 단위로 고르세요. 지킬 수 있는 약속일 때만 저장합니다."
          }
        }
      }
    },
    "settings.goal.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily goal saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 목표를 저장했습니다."
          }
        }
      }
    },
    "settings.rest.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first missed day of each calendar week is covered automatically. It does not create focus minutes or rewards; another missed day that week reduces the streak."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매주 첫 결석 하루는 자동으로 보호됩니다. 집중 시간이나 보상은 만들지 않으며, 같은 주에 다시 결석하면 연속 일수가 줄어듭니다."
          }
        }
      }
    },
    "settings.blockList.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which distractions stay outside during a sealed expedition."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봉인 출정 동안 갱도 밖에 둘 방해 대상을 고르세요."
          }
        }
      }
    },
    "settings.blockList.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine door list saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱도 문 목록을 저장했습니다."
          }
        }
      }
    },
    "settings.blockList.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list was not saved. Your previous list remains."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 저장하지 못했습니다. 이전 목록은 그대로입니다."
          }
        }
      }
    },
    "settings.permission.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비됨"
          }
        }
      }
    },
    "settings.permission.needsSelection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a list"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록 필요"
          }
        }
      }
    },
    "settings.permission.notAsked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not requested"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 요청 안 함"
          }
        }
      }
    },
    "settings.permission.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs attention"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 필요"
          }
        }
      }
    },
    "settings.permission.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 없음"
          }
        }
      }
    },
    "settings.permission.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live readiness changed, but its local receipt could not be saved. Try again after storage recovers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 준비 상태는 바뀌었지만 기기 내 확인 기록을 저장하지 못했습니다. 저장소가 복구되면 다시 시도해 주세요."
          }
        }
      }
    },
    "settings.recovery.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine records recovered"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채굴 기록을 복구했습니다"
          }
        }
      }
    },
    "settings.recovery.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepMine protected a readable copy and started from safe records. No action is required."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 있는 기록을 보호하고 안전한 상태로 시작했습니다. 따로 할 일은 없습니다."
          }
        }
      }
    },
    "settings.feedback.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the quiet signals used when a return is revealed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀환 결과를 공개할 때 사용할 조용한 신호를 고르세요."
          }
        }
      }
    },
    "settings.about.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About DeepMine"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepMine 정보"
          }
        }
      }
    },
    "settings.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game records stay on this device. DeepMine reads only the readiness needed to run the mine door."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 기록은 이 기기에 보관됩니다. DeepMine은 갱도 문에 필요한 준비 상태만 확인합니다."
          }
        }
      }
    },
    "settings.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전"
          }
        }
      }
    },
    "prestige.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep descent resets this run's tools for permanent core shards. Depth never goes down."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심층 진입은 이번 탐사의 장비를 초기화하고 영구 핵 조각을 줍니다. 심도는 줄어들지 않습니다."
          }
        }
      }
    },
    "prestige.progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep descent progress"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심층 진입 진행도"
          }
        }
      }
    },
    "prestige.ineligible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep focusing until the target is reached."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 닿을 때까지 집중을 이어가세요."
          }
        }
      }
    },
    "prestige.eligible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deep descent is ready. Review every loss before continuing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심층 진입 준비가 끝났습니다. 계속하기 전에 사라질 항목을 모두 확인하세요."
          }
        }
      }
    },
    "prestige.loss.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These will be reset"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 항목이 초기화됩니다"
          }
        }
      }
    },
    "prestige.loss.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ore, this run's focus and your tools return to their starting values. Depth, crystals, records, streak, themes and lifetime focus all stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광석, 이번 회차 집중, 장비가 시작값으로 돌아갑니다. 심도, 수정, 기록, 연속 일수, 테마, 누적 집중은 유지됩니다."
          }
        }
      }
    },
    "prestige.gain.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core shards gained"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획득할 핵 조각"
          }
        }
      }
    },
    "prestige.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and enter the deep"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손실 확인 후 심층 진입"
          }
        }
      }
    },
    "prestige.allocation.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allocate core shards"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵 조각 배분"
          }
        }
      }
    },
    "prestige.allocation.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend shards on permanent mine upgrades, or keep them for later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵 조각을 영구 광산 강화에 쓰거나 다음을 위해 보관하세요."
          }
        }
      }
    },
    "prestige.upgrade.memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excavation memory"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채굴 기억"
          }
        }
      }
    },
    "prestige.upgrade.resonance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resonance detection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공명 탐지"
          }
        }
      }
    },
    "prestige.upgrade.time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed time"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 시간"
          }
        }
      }
    },
    "prestige.effect.memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level adds 8% to base return ore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨마다 기본 귀환 광석이 8% 늘어납니다."
          }
        }
      }
    },
    "prestige.effect.resonance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level adds 1 percentage point to vein chance."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨마다 광맥 확률이 1%p 늘어납니다."
          }
        }
      }
    },
    "prestige.effect.time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level adds 5% to long-expedition reward."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨마다 장기 출정 보상이 5% 늘어납니다."
          }
        }
      }
    },
    "prestige.insufficient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough core shards, or the upgrade is already complete."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵 조각이 부족하거나 이미 최대 단계입니다."
          }
        }
      }
    },
    "prestige.upgrade.success": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent upgrade installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 강화를 장착했습니다."
          }
        }
      }
    },
    "prestige.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deep descent was not confirmed. Your current mine remains unchanged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심층 진입을 확인하지 못했습니다. 현재 광산은 그대로입니다."
          }
        }
      }
    },
    "action.abandon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandon mine"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채굴 포기"
          }
        }
      }
    },
    "action.buy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매"
          }
        }
      }
    },
    "action.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "action.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        }
      }
    },
    "action.finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마치기"
          }
        }
      }
    },
    "action.nextExpedition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare next expedition"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 출정 준비"
          }
        }
      }
    },
    "action.openApp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open DeepMine"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepMine 열기"
          }
        }
      }
    },
    "action.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow and continue"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하고 계속"
          }
        }
      }
    },
    "action.installUpgrade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install drill upgrade"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드릴 강화 장착"
          }
        }
      }
    },
    "action.next": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음"
          }
        }
      }
    },
    "action.notNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에"
          }
        }
      }
    },
    "action.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        }
      }
    },
    "action.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장"
          }
        }
      }
    },
    "action.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택"
          }
        }
      }
    },
    "action.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start mining"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채굴 시작"
          }
        }
      }
    },
    "action.upgrade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade"
          }
        },
